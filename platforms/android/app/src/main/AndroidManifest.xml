<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v1.17.2 THE BRIDGE: the RUN_COMMAND intent contract (PLAN-V117).
         Termux (F-Droid build only — the Play one is dead at 0.101) requires
         BOTH apps to declare this permission and the USER to grant it in
         Settings → Apps → Doomalay → Permissions → Additional permissions.
         Dangerous-level on purpose: it lets us ask Termux to run a jailed
         one-shot bash command and get stdout/stderr/exitCode back through
         a PendingIntent. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- v1.17.2: package visibility (targetSdk ≥ 30). Without this entry
         PackageManager lookups for com.termux return "not installed" even
         when it IS installed — the honest-state ladder would lie. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:label="Doomalay"
        android:theme="@style/Theme.Doomalay"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:extractNativeLibs="true">

        <activity android:name=".MainActivity" android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Doomalay"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v0.60: the auth done page's "← return to the app" button →
                 doomalay://return. singleTop above means an already-running
                 app just gets onNewIntent (no recreate — the WebView, its
                 SPA state and the connect panel survive), and the WebView's
                 visibilitychange refetches /api/hf/account so the panel
                 flips to connected the moment the user is back. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="doomalay" />
            </intent-filter>
        </activity>

        <!-- v0.62.3: THE IN-APP BROWSER — the second WebView every external
             link opens in (top-level navigation: frame guards don't apply,
             so the key consoles render fully in-app). Never exported: it
             is only ever launched by MainActivity's handleUrl / the
             __doomalayKotlin.openInApp bridge. -->
        <activity android:name=".ViewerActivity" android:exported="false"
            android:theme="@style/Theme.Doomalay"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service android:name=".EngineService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
</manifest>
