<?xml version="1.0" encoding="utf-8"?>
<!-- v0.63.4: THE BOX+ARROW (the user's icon spec — "a clear box and arrow
     like YouTube"): the Lucide external-link glyph (ISC License, the same
     corpus as web/icons.js), stroked. Stroke color is white; the runtime
     imageTintList (ViewerActivity) recolors it with the live web-theme
     snapshot — nothing hardcoded in use. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
