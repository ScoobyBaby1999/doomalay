digraph DoomalayLite {
  graph [rankdir="BT", splines="spline", nodesep="0.55", ranksep="1.0", fontname="DejaVu Sans", bgcolor="white", compound="true"];
  node [fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans"];
  subgraph "cluster_DoomalayLite" {
    label=<<FONT FACE="DejaVu Sans" POINT-SIZE="12" COLOR="#64748B"><B>DoomalayLite</B></FONT>>;
    style="rounded"; color="#CBD5E1"; margin="14";
  "Program" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="9" COLOR="#64748B">DoomalayLite</FONT><BR/></TD></TR><TR><TD COLOR="#4C6EF5" BORDER="2" BGCOLOR="#DBEAFE"><FONT FACE="DejaVu Sans" POINT-SIZE="13" COLOR="#243447"><B>Program</B></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#243447"> - &amp; Main(args : string[]) : void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=rect];
      }
  subgraph "cluster_DoomalayLite.Core" {
    label=<<FONT FACE="DejaVu Sans" POINT-SIZE="12" COLOR="#64748B"><B>DoomalayLite.Core</B></FONT>>;
    style="rounded"; color="#CBD5E1"; margin="14";
  "ChatRole" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="9" COLOR="#64748B">DoomalayLite.Core</FONT><BR/></TD></TR><TR><TD COLOR="#0F766E" BORDER="2" BGCOLOR="#D1FAE5"><FONT FACE="DejaVu Sans" POINT-SIZE="13" COLOR="#243447"><I>«enumeration»</I><BR/><B>ChatRole</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#243447"> System<BR ALIGN="LEFT"/> User<BR ALIGN="LEFT"/> Assistant<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=rect];
      "ChatMessage" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="9" COLOR="#64748B">DoomalayLite.Core</FONT><BR/></TD></TR><TR><TD COLOR="#4C6EF5" BORDER="2" BGCOLOR="#DBEAFE"><FONT FACE="DejaVu Sans" POINT-SIZE="13" COLOR="#243447"><B>ChatMessage</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#243447"> - _createdAt : DateTime<BR ALIGN="LEFT"/> + Role : ChatRole {readonly}<BR ALIGN="LEFT"/> + Content : string<BR ALIGN="LEFT"/> + CreatedAt : DateTime {readonly}<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#243447"> + ChatMessage(content : string)<BR ALIGN="LEFT"/> + ChatMessage(role : ChatRole, content : string)<BR ALIGN="LEFT"/> + ToString() : string {override}<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=rect];
      "Conversation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="9" COLOR="#64748B">DoomalayLite.Core</FONT><BR/></TD></TR><TR><TD COLOR="#4C6EF5" BORDER="2" BGCOLOR="#DBEAFE"><FONT FACE="DejaVu Sans" POINT-SIZE="13" COLOR="#243447"><B>Conversation</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#243447"> - _messages : List&lt;ChatMessage&gt;<BR ALIGN="LEFT"/> - _maxMessages : int<BR ALIGN="LEFT"/> + Count : int {readonly}<BR ALIGN="LEFT"/> + MaxMessages : int {readonly}<BR ALIGN="LEFT"/> + Messages : IReadOnlyList&lt;ChatMessage&gt; {readonly}<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#243447"> + Conversation()<BR ALIGN="LEFT"/> + Conversation(maxMessages : int)<BR ALIGN="LEFT"/> + Add(message : ChatMessage) : void<BR ALIGN="LEFT"/> + AddUserMessage(content : string) : void<BR ALIGN="LEFT"/> + AddAssistantMessage(content : string) : void<BR ALIGN="LEFT"/> + Clear() : void<BR ALIGN="LEFT"/> + Render() : string<BR ALIGN="LEFT"/> - Trim() : void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=rect];
      "ApiSettings" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="9" COLOR="#64748B">DoomalayLite.Core</FONT><BR/></TD></TR><TR><TD COLOR="#4C6EF5" BORDER="2" BGCOLOR="#DBEAFE"><FONT FACE="DejaVu Sans" POINT-SIZE="13" COLOR="#243447"><B>ApiSettings</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#243447"> + EndpointUrl : string<BR ALIGN="LEFT"/> + ModelName : string<BR ALIGN="LEFT"/> + ApiKey : string<BR ALIGN="LEFT"/> + TimeoutSeconds : int<BR ALIGN="LEFT"/> + SystemPrompt : string<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#243447"> + ApiSettings()<BR ALIGN="LEFT"/> + ApiSettings(apiKey : string)<BR ALIGN="LEFT"/> + ApiSettings(apiKey : string, modelName : string)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=rect];
      "ChatReply" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><FONT POINT-SIZE="9" COLOR="#64748B">DoomalayLite.Core</FONT><BR/></TD></TR><TR><TD COLOR="#4C6EF5" BORDER="2" BGCOLOR="#DBEAFE"><FONT FACE="DejaVu Sans" POINT-SIZE="13" COLOR="#243447"><B>ChatReply</B></FONT></TD></TR><TR><TD BGCOLOR="#FFFFFF" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#243447"> + Content : string<BR ALIGN="LEFT"/> + ModelUsed : string<BR ALIGN="LEFT"/> + ElapsedSeconds : double<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD BGCOLOR="#F8FAFC" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#243447"> + ChatReply(content : string, modelUsed : string)<BR ALIGN="LEFT"/> + ChatReply(content : string, modelUsed : string, elapsedSeconds : double)<BR ALIGN="LEFT"/> + ToString() : string {override}<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=rect];
      }
  legend [shape=rect, style="rounded,filled", fillcolor="#F8FAFC", color="#94A3B8", label=< <FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#243447"><B>Legend</B><BR ALIGN="LEFT"/>+ public&#160;&#160;- private&#160;&#160;# protected&#160;&#160;&amp; static<BR ALIGN="LEFT"/>{abstract} {override} {virtual} {readonly}<BR ALIGN="LEFT"/>hollow triangle = inheritance &#160; dashed = realization / dependency<BR ALIGN="LEFT"/>filled diamond = composition (at the whole)<BR ALIGN="LEFT"/></FONT>>];
  "ChatMessage" -> "Conversation" [COLOR="#475569", penwidth="1.4", dir="back", arrowtail="diamond", label=<messages>, fontsize="10", fontcolor="#64748B", taillabel=<1..*>, labeldistance="1.6", labelangle="18", headlabel=<1>, labeldistance="1.6", labelangle="-18"];
  "ChatMessage" -> "ChatRole" [COLOR="#475569", penwidth="1.4", arrowhead="vee", label=<role>, fontsize="10", fontcolor="#64748B", headlabel=<1>, labeldistance="1.6", labelangle="-18"];
  "Conversation" -> "ChatMessage" [COLOR="#475569", penwidth="1.4", arrowhead="vee", style="dashed", label=<creates>, fontsize="10", fontcolor="#64748B", taillabel=<1>, labeldistance="1.6", labelangle="18", headlabel=<1..*>, labeldistance="1.6", labelangle="-18"];
}
